// Back-office access policies (PSL). Translated from legacy_policy_store/back_office.yaml
// (bundle.back_office 1.0.0). Deny-overrides; see front_office.psl.

// @policy_set bundle.back_office
// @version 2.0.0
// @source legacy_policy_store/back_office.yaml
vunit back_office (pdp_request) {

  // @rule policy.back_office.report_read_reconciliation
  // @nl Report agent may read reconciliation results in the verified EOD workflow.
  // @permit
  // @obligation enhanced_logging(reason=reconciliation_report_access)
  property report_read_reconciliation =
      subject.id == "agent.back_office.report"
      && resource.id == "resource.back_office.reconciliation_results"
      && action == "read"
      && workflow.id == "workflow.back_office.eod_processing";

  // @rule policy.back_office.report_deny_ledger_update
  // @nl Report agent must never modify the ledger.
  report_deny_ledger_update: assert never (authz_request
      && subject.id == "agent.back_office.report"
      && resource.id == "resource.back_office.ledger"
      && action == "update");

  // @rule policy.back_office.eod_read_batches
  // @nl EOD agent may read EOD batches in the verified EOD workflow.
  // @permit
  // @obligation enhanced_logging(reason=eod_batch_access)
  property eod_read_batches =
      subject.id == "agent.back_office.eod"
      && resource.id == "resource.back_office.eod_batches"
      && action == "read"
      && workflow.id == "workflow.back_office.eod_processing";
}
