// Mid-office access policies (PSL). Translated from legacy_policy_store/mid_office.yaml
// (bundle.mid_office 1.0.0). Deny-overrides; see front_office.psl.

// @policy_set bundle.mid_office
// @version 2.0.0
// @source legacy_policy_store/mid_office.yaml
vunit mid_office (pdp_request) {

  // @rule policy.mid_office.operations_read
  // @nl Data-analysis role may read internal operations data.
  // @permit
  property operations_read =
      subject.role.operations_analyst
      && resource.id == "resource.mid_office.internal_operations_data"
      && action == "read";

  // @rule policy.mid_office.financial_data_read
  // @nl Financial-data agent may read masked financial data with verified stronger authentication.
  // @permit
  // @obligation data_masking(fields=[full_account_number, ssn])
  // @obligation enhanced_logging(reason=financial_customer_data)
  property financial_data_read =
      subject.id == "agent.mid_office.financial_data"
      && resource.id == "resource.mid_office.financial_customer_data"
      && action == "read"
      && auth.strength >= 2
      && (risk.level == "low" || risk.level == "medium");

  // @rule policy.mid_office.support_guidance_business_hours
  // @nl Support-guidance agent may read operations data only during server-verified weekday business hours.
  // @permit
  property support_guidance_business_hours =
      subject.id == "agent.mid_office.support_guidance"
      && resource.id == "resource.mid_office.internal_operations_data"
      && action == "read"
      && time.in.business_hours_new_york;
}
