# Allowlist: only the Backplane packages the runtime image installs.
*
!packages
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.egg-info
**/.venv
**/tests
# local development trust material never enters the image (deployments generate their own)
packages/zt-pdp/security/dev_keys
packages/zt-pdp/policy_store/*.sig.json
packages/zt-pdp/legacy_policy_store/*.sig.json
packages/zt-pdp/runtime
packages/zt-pep/runtime
packages/zt-pep/generated
packages/zt-interface/generated
packages/zt-distributed/runtime
packages/zt-distributed/results
packages/zt-distributed/deploy/vendor
