// Core PDP rules (PSL) that apply to every request.
// Previously hard-coded in zt_backplane/engine.py (CRITICAL_WRITE_ACTIONS check); now a
// policy like every other, signed and auditable.

// @policy_set core
// @version 1.0.0
// @source zt_backplane/engine.py (critical-write rule, removed from code)
vunit core (pdp_request) {

  property critical_write_action =
      action == "execute" || action == "update" || action == "approve" || action == "reject"
      || action == "submit" || action == "cancel" || action == "store" || action == "create";

  // @rule core.critical_write_requires_dual_approval
  // @nl A write to a critical resource requires a signed human approval and an independent secondary authorization, both bound to the request hash.
  // @on_violation MANUAL_REVIEW
  critical_write_requires_dual_approval: assert always (authz_request
      && resource.critical && critical_write_action
      -> approval.valid && approval.secondary_valid);
}
