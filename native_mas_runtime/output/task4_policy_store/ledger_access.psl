// Ledger access policies (PSL). Translated from legacy_policy_store/ledger_access.yaml
// (bundle.ledger_access 1.0.0). Deny-overrides; see front_office.psl.

// @policy_set bundle.ledger_access
// @version 2.0.0
// @source legacy_policy_store/ledger_access.yaml
vunit ledger_access (pdp_request) {

  // @rule policy.ledger.report_deny_update
  // @nl Explicitly deny report-agent ledger writes.
  report_deny_update: assert never (authz_request
      && subject.id == "agent.back_office.report"
      && resource.id == "resource.back_office.ledger"
      && action == "update");

  // EOD ledger update. Legacy: MANUAL_REVIEW policy (priority 300) overridden by an ALLOW
  // policy with both approvals (priority 360). As deny-overrides: the update is permitted
  // in the EOD workflow, and it is held for manual review unless both approvals are valid.

  // @rule policy.ledger.eod_approved_update
  // @nl EOD ledger update may proceed only with signed human approval and independent authorization bound to the request hash.
  // @permit
  // @obligation enhanced_logging(reason=critical_ledger_write)
  // @obligation require_idempotency_key
  // @obligation require_change_ticket
  // @obligation independent_resource_audit
  property eod_approved_update =
      subject.id == "agent.back_office.ledger_update"
      && resource.id == "resource.back_office.ledger"
      && action == "update"
      && workflow.id == "workflow.back_office.eod_processing";

  // @rule policy.ledger.eod_pending_review
  // @nl EOD ledger update remains blocked until signed approval and an independent authorization are present.
  // @on_violation MANUAL_REVIEW
  eod_pending_review: assert always (authz_request
      && subject.id == "agent.back_office.ledger_update"
      && resource.id == "resource.back_office.ledger"
      && action == "update"
      && workflow.id == "workflow.back_office.eod_processing"
      -> approval.valid && approval.secondary_valid);
}
