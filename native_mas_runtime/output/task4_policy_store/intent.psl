// @policy_set intent.harness_output
// @version 1.0.0
// @source zero_trust_task1/manifest/policy_intent.yaml
// @runtime harness
vunit intent_harness_output (harness_output) {

  // @rule intent.required-text-terms-in-decision-output
  // @nl The decision_making_agent output must contain all required terms for the active scenario (decision, confidence, rationale). Missing terms indicate hallucination or incomplete reasoning. Corresponds to evaluator check: required_text_terms_present.
  // @source zero_trust_task1/manifest/policy_intent.yaml#required-text-terms-in-decision-output
  // @on_violation MANUAL_REVIEW
  // @obligation audit_log
  intent_required_text_terms_in_decision_output: assert always (harness_check -> output.required_terms_present);

  // @rule intent.expected-status-must-match
  // @nl For scenarios with a known expected status, the agent output must match the expected value. Mismatch signals a failure mode. Corresponds to evaluator check: expected_status_matched.
  // @source zero_trust_task1/manifest/policy_intent.yaml#expected-status-must-match
  // @on_violation MANUAL_REVIEW
  // @obligation audit_log
  intent_expected_status_must_match: assert always (harness_check -> output.status_matches_expectation);
