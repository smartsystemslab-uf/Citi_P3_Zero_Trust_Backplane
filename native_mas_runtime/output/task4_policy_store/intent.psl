// @policy_set intent.workflow_run
// @version 1.0.0
// @source zero_trust_task1/manifest/policy_intent.yaml
// @runtime native,gateway
vunit intent_workflow_run (workflow_run) {

  // @rule intent.execute-transfer-caller-restriction.order
  // @nl execute_transfer may only be called by transaction_processing_agent. No other agent in the system has authority to move money. Corresponds to evaluator check: required_tools_present and forbidden_tools_absent.
  // @source zero_trust_task1/manifest/policy_intent.yaml#execute-transfer-caller-restriction
  // @note session_state.fo_service_result.execution_required == true: the customer-service agent's decision to execute is LLM output with no trusted counterpart; the rule requires that the customer-service step ran
  intent_execute_transfer_caller_restriction_order: assert ((agent_routed && route.to == "customer_service_agent") before (tool_admitted && tool.name == "execute_transfer" && tool.agent == "transaction_processing_agent"));

  // @rule intent.apply-ledger-updates-pipeline-gate.order
  // @nl apply_ledger_updates requires that the full EOD pipeline has run: validation must confirm readiness and processing must have produced posting instructions. Prevents ledger writes without upstream validation. Corresponds to evaluator check: required_result_keys_present.
  // @source zero_trust_task1/manifest/policy_intent.yaml#apply-ledger-updates-pipeline-gate
  intent_apply_ledger_updates_pipeline_gate_order: assert ((tool_succeeded && tool.name == "validate_eod_readiness") before (tool_admitted && tool.name == "apply_ledger_updates" && tool.agent == "ledger_update_agent")) && ((tool_succeeded && tool.name == "validate_eod_readiness" && result.ready) before (tool_admitted && tool.name == "apply_ledger_updates" && tool.agent == "ledger_update_agent")) && ((tool_succeeded && tool.name == "get_eod_batch") before (tool_admitted && tool.name == "apply_ledger_updates" && tool.agent == "ledger_update_agent"));

  // @rule intent.resolve-ledger-entry-valid-amount.order
  // @nl resolve_ledger_entry correction_amount must be a non-zero finite number. A zero correction is a no-op and indicates an upstream error.
  // @source zero_trust_task1/manifest/policy_intent.yaml#resolve-ledger-entry-valid-amount
  intent_resolve_ledger_entry_valid_amount_order: assert ((tool_succeeded && tool.name == "get_reconciliation_data") before (tool_admitted && tool.name == "resolve_ledger_entry" && tool.agent == "exception_agent"));

  // @rule intent.submit-manual-review-decision-agent-only.order
  // @nl submit_manual_review may only be called by decision_making_agent. Monitoring and fraud agents must not escalate directly — they must surface findings and let the decision agent act.
  // @source zero_trust_task1/manifest/policy_intent.yaml#submit-manual-review-decision-agent-only
  intent_submit_manual_review_decision_agent_only_order: assert ((tool_succeeded && tool.agent == "transaction_monitoring_agent") before (tool_admitted && tool.name == "submit_manual_review" && tool.agent == "decision_making_agent")) && ((tool_succeeded && tool.agent == "fraud_detection_agent") before (tool_admitted && tool.name == "submit_manual_review" && tool.agent == "decision_making_agent")) && ((tool_succeeded && tool.agent == "compliance_agent") before (tool_admitted && tool.name == "submit_manual_review" && tool.agent == "decision_making_agent"));

  // @rule intent.require-upstream-reports-before-decision.order
  // @nl decision_making_agent must not produce fo_decision_report unless all three upstream specialist reports are present in session state. Corresponds to evaluator checks: required_result_keys_present and expected_decision_matched.
  // @source zero_trust_task1/manifest/policy_intent.yaml#require-upstream-reports-before-decision
  // @note obligations ['audit_log'] are not attached to temporal rules
  intent_require_upstream_reports_before_decision_order: assert ((tool_succeeded && tool.agent == "transaction_monitoring_agent") before (agent_routed && route.to == "decision_making_agent")) && ((tool_succeeded && tool.agent == "fraud_detection_agent") before (agent_routed && route.to == "decision_making_agent")) && ((tool_succeeded && tool.agent == "compliance_agent") before (agent_routed && route.to == "decision_making_agent"));

  // @rule intent.require-validation-before-ledger.order
  // @nl ledger_update_agent must not write bo_ledger_update_report unless the validation checkpoint confirmed readiness. Amounts in the processing report must be consistent with the batch totals. Corresponds to evaluator check: mismatch_amount_consistent.
  // @source zero_trust_task1/manifest/policy_intent.yaml#require-validation-before-ledger
  intent_require_validation_before_ledger_order: assert ((tool_succeeded && tool.name == "validate_eod_readiness" && result.ready) before (tool_admitted && tool.name == "apply_ledger_updates" && tool.agent == "ledger_update_agent"));
}
