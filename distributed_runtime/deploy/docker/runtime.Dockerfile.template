# Runtime image of the distributed runtime for ONE protected ADK application: gateway PEP, agent
# workloads, agent-credential issuer, ingress client, ops helper. Generated per application by
# `ctl build --project ...` (scripts/stack.py) into runtime/build/runtime.Dockerfile.
#   build context:          the Backplane root (filtered by runtime.Dockerfile.dockerignore)
#   named context `app`:    the staged copy of the application (runtime/build/app)
FROM {python_image}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 1. the application's own requirements first: they decide the google-adk version
{copy_requirements}
RUN {install_requirements}

# 2. the Backplane (editable installs keep the packages' source layout: interface contracts, resources)
COPY interface_standard /opt/zt/interface_standard
COPY Zero_Trust_Task3_PEP_Integrated/zero_trust_pep_task3_integrated /opt/zt/task3
COPY zero_trust_pdp_task4_secure /opt/zt/task4
COPY zero_trust_task5 /opt/zt/task5
COPY zero_trust_psl /opt/zt/psl
COPY zero_trust_identity /opt/zt/identity
COPY zero_trust_adk /opt/zt/adk
COPY distributed_runtime/deploy/requirements.txt /tmp/zt-requirements.txt
RUN pip install -r /tmp/zt-requirements.txt \
        -e /opt/zt/interface_standard -e /opt/zt/task3 -e /opt/zt/task4 -e /opt/zt/task5 \
        -e /opt/zt/psl -e /opt/zt/identity -e /opt/zt/adk \
 && pip freeze --exclude-editable > /opt/pip-freeze.txt
COPY distributed_runtime/zt_distributed /opt/zt/distributed_runtime/zt_distributed

# 3. the application
COPY --from=app . /opt/app
ENV ZT_ADK_PROFILE=/opt/app/{profile_name} \
    PYTHONPATH=/opt/zt/distributed_runtime \
    ZT_DEPLOYMENT=/etc/zt/deployment.json

# Fail the build if the time-zone database is missing (PSL windows), a development key or a
# secret of the application made it into the image, or the application cannot be protected
# (discovery errors: duplicate agent names, AgentTool without plugins, unsupported tools).
RUN python -c "from zoneinfo import ZoneInfo; ZoneInfo('America/New_York')" \
 && ! ls /opt/zt/task4/security/dev_keys/*.pem 2>/dev/null \
 && test ! -e /opt/app/.env && test ! -e /opt/app/.zt \
 && python -m zt_distributed.describe > /opt/describe.json \
 && chmod -R a+rX /opt/zt /opt/app
WORKDIR /opt/app
